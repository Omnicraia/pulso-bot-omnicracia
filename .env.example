# Copia este archivo como .env y llena tus valores.
# El bot de Telegram (lo creas en @BotFather, es gratis).
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu chat_id (para recibir /stats). Escríbele a @userinfobot en Telegram y te lo dice.
ADMIN_ID=0

# Zona horaria y hora del Pulso diario (24h). 20:00 = 8 PM.
TZ=America/Mexico_City
SEND_HOUR=20
SEND_MIN=0

# Segundos entre mensajes en el envío masivo (0.05 = ~20/seg, seguro para Telegram).
THROTTLE=0.05

# Días sin confirmar antes de mandar reactivación.
LAPSE_DAYS=3
